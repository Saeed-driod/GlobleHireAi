{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/(.*)", "destination": "http://150.136.214.192/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
