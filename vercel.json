{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "http://150.136.214.192/api/sitemap" },
    { "source": "/api/(.*)", "destination": "http://150.136.214.192/api/$1" },
    { "source": "/jobs/(.*)", "destination": "/spa.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
